# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hello_jobs?schema=public"

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Secret for the daily maintenance endpoint (GET /api/cron/cleanup).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- Login codes (OTP) ---
# A deployed site cannot send login codes until a WhatsApp/SMS provider is wired in
# (src/lib/otp.ts). For a PRIVATE test site you can show the code on screen instead,
# but ONLY for the numbers you list. Anyone who types a listed number can log in as it.
# Only the exact value "true" turns this on. See docs/DEPLOY.md.
OTP_DEMO_MODE=""
OTP_DEMO_ALLOWLIST=""   # e.g. "98765 43210, 99887 76655"
