# Copy to .env for local development. Never commit the real file.

# --- Required in production ------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, RDS ... any Postgres 14+).
DATABASE_URL="postgres://user:password@host:5432/hellojobs?sslmode=require"
# At least 32 random characters. Used to hash login codes. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Public address of the site, e.g. https://hellojobs.in (used for the origin check).
APP_URL=""

# --- Staff accounts --------------------------------------------------------
# Comma separated 10-digit mobile numbers that become Trust & Safety admins on startup.
# Staff sign in at https://your-site/#staff with a WhatsApp code.
ADMIN_BOOTSTRAP_PHONES=""

# --- Login codes over WhatsApp (Meta WhatsApp Cloud API) ---------------------
# Needs an approved AUTHENTICATION template. Without these, production cannot send codes.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE=""
WHATSAPP_OTP_LANGUAGE="en"
WHATSAPP_API_VERSION="v21.0"

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Scheduled cleanup (Vercel Cron sends this automatically) -----------------
CRON_SECRET=""

# --- Optional switches --------------------------------------------------------
# Run SQL migrations automatically on the first request (default true).
AUTO_MIGRATE="true"
# Pilot only: show the login code on screen for the numbers listed (NEVER for real users).
OTP_DEMO_MODE="false"
OTP_DEMO_ALLOWLIST=""
# Pilot only: let employers "buy" credits without paying (NEVER with real money flows).
PAYMENTS_DEMO_MODE="false"

# --- Public contact details (shown on the site; set before launch) -------------
VITE_GRIEVANCE_OFFICER_NAME=""
VITE_GRIEVANCE_EMAIL=""
VITE_HELPLINE=""
VITE_COMPANY_ADDRESS=""
